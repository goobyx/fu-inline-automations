{
  "id": "fu-inline-automations",
  "title": "FU Automatic Effects",
  "description": "Automatically applies Fabula Ultima effects like @GAIN, @LOSS, and @EFFECT from item descriptions.",
  "authors": [
    {
      "name": "goobyx"
    }
  ],
  "version": "#{VERSION}#",
  "compatibility": {
    "minimum": "13",
    "verified": "13",
    "maximum": "13"
  },
  "esmodules": [
    "dist/module.js"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "languages/en.json"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "projectfu",
        "type": "system",
        "compatibility": {}
      }
    ],
    "requires": [
      {
        "id": "socketlib",
        "type": "module",
        "manifest": "https://github.com/farling42/foundryvtt-socketlib/releases/latest/download/module.json"
      }
    ],
    "conflicts": []
  },
  "socket": true,
  "url": "#{URL}#",
  "manifest": "#{MANIFEST}#",
  "download": "#{DOWNLOAD}#",
  "license": "GPL-3.0-only",
  "readme": "https://github.com/goobyx/fu-inline-automations/blob/main/README.md",
  "bugs": "https://github.com/goobyx/fu-inline-automations/issues",
  "changelog": "https://github.com/goobyx/fu-inline-automations/blob/main/CHANGELOG.md",
  "flags": {
    "allowBugReporter": true,
    "coreTranslation": false
  },
  "protected": false,
  "coreTranslation": false,
  "library": false
}